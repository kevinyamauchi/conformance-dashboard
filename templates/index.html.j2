<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ config.title }}</title>
<link rel="stylesheet" href="style.css" />
</head>
<body style="--table-header-bg: {{ config.table_header_color }}; --paper: {{ config.background_color }}; --content-ink: {{ config.text_font_color }}; --table-header-ink: {{ config.table_header_font_color }}; --table-ink: {{ config.table_font_color }};">

<header class="page-header">
  <h1>{{ config.title }}</h1>
  {% if main_text_html %}
  <div class="subtitle">{{ main_text_html|safe }}</div>
  {% endif %}
</header>

<main>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th class="col-group" colspan="2">Library</th>
          {% for group in column_groups %}
          <th class="col-group" colspan="{{ group.tests|length }}">{{ group.label }}</th>
          {% endfor %}
        </tr>
        <tr>
          <th class="col-name">Name</th>
          <th class="col-group-end">Version</th>
          {% for group in column_groups %}
          {% for test in group.tests %}
          <th{% if loop.last %} class="col-group-end"{% endif %}>{{ test.label }}</th>
          {% endfor %}
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr>
          <td class="cell--name">
            {% if row.homepage %}
            <a href="{{ row.homepage }}" target="_blank" rel="noopener noreferrer">{{ row.name }}</a>
            {% else %}
            {{ row.name }}
            {% endif %}
          </td>
          <td class="cell--version col-group-end">{{ row.version }}</td>
          {% for cell in row.cells %}
          <td{% if cell.group_end %} class="col-group-end"{% endif %}>
            {% if cell.kind == "chip" %}
            <span class="chip {{ cell.css_class }}">{{ cell.text }}</span>
            {% else %}
            <span class="gauge" style="--gauge-bg: {{ cell.bg }}; --gauge-accent: {{ cell.accent }}; --gauge-pct: {{ cell.pct }}%;">
              <span class="gauge__fill"></span>
              <span class="gauge__label">{{ cell.text }}</span>
            </span>
            {% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <footer class="page-footer">
    {% if footer_html %}
    <div class="footer-text">{{ footer_html|safe }}</div>
    {% endif %}
    <p id="generated-at">Data last built {{ generated_at.strftime("%b %-d, %Y, %H:%M UTC") }}</p>
  </footer>
</main>

</body>
</html>
